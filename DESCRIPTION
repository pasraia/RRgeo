Package: RRgeo
Type: Package
Title: Species Distribution Modelling for Rare Species
Version: 0.0.6
Authors@R: c(
    person(given = "Alessandro", family = "Mondanaro", role = "aut"),
    person(given = c("Mirko", "Di"), family = "Febbraro", role = "aut"),
